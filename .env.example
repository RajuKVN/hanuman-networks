# The only env var the app needs.
# Use the hash-free raw URL so it always points to the latest Gist version:
#   https://gist.githubusercontent.com/YOUR_USER/GIST_ID/raw/plans.json
# Do NOT use the versioned URL (the one with a 40-char hash in the middle).
VITE_GIST_URL=https://gist.githubusercontent.com/YOUR_USER/GIST_ID/raw/plans.json
